    "belopp_nara": true
   },
   {
    "sida": 18,
    "ord": "statsbidrag",
    "reform": false,
    "utdrag": "barngrupper i förskolan och för att minska barngruppernas storlek vilka kan vara åtgärder för att höja kvaliteten i förskolan. Regeringen föreslog att statsbidraget förstärks med 900 miljoner kronor för 2025. I budgetpropositionen för 2026 förstärkte regeringen statsbidraget förstärks med ytterligare 500 miljoner",
    "belopp_nara": true
   },
